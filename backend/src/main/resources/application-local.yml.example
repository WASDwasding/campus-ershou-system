# 复制为同目录 application-local.yml 后再填写。该文件已被 gitignore。
#
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#
# 本机 MySQL 有两种用法，和仓库里的 application.yml 默认值（127.0.0.1:3306 / campus）不是一回事：
# 1. 推荐：bash sql/start-local-mysql.sh  →  127.0.0.1:3307，root / campus，库 campus_ershou
# 2. 系统已安装的 MySQL（常见是 3306）：把下面 url 端口改成 3306，password 改成你自己的 root 密码
# 服务器用 /opt/campus-ershou/application-local.yml 覆盖，不要把真实密钥提交进仓库。

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3307/campus_ershou?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: campus
  data:
    redis:
      host: 127.0.0.1
      port: 6379
  mail:
    host: smtp.163.com
    port: 465
    username: campus_cat_bazaar@163.com
    password: "163 客户端授权码，不是登录密码"
    properties:
      mail.smtp.auth: true
      mail.smtp.ssl.enable: true
      mail.smtp.ssl.required: true
      mail.smtp.ssl.trust: smtp.163.com

app:
  jwt:
    secret: PleaseChangeThisJwtSecretKeyToAtLeast32Chars!!
  student-no:
    hmac-key: PleaseChangeStudentNoHmacKeyTo16Chars
  mail:
    enabled: false
    expose-code: true
    from: campus_cat_bazaar@163.com
  file:
    # 服务器示例。本机用 application.yml 的默认值即可。
    # dir: /opt/campus-ershou/files
    # public-base-url: https://simpleyi.site
    sign-key: PleaseChangeFileSignKeyToAtLeast16Chars
