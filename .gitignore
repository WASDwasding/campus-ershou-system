# ---------- 敏感配置：绝对不要提交 ----------
# 数据库密码、OSS/短信密钥、JWT secret 一律走本地文件或环境变量
*.local
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-local.properties
application-dev.yml
application-prod.yml
*.pem
*.key
*.jks
*.p12
*.keystore

# ---------- Java / Maven / Gradle ----------
target/
build/
out/
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/
*.class
*.jar
*.war
*.ear
!**/gradle/wrapper/gradle-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar
.gradle/
.mvn/timing.properties
hs_err_pid*
replay_pid*

# ---------- Node / Vue 前端 ----------
node_modules/
dist/
dist-ssr/
.output/
.nuxt/
.vite/
.vitepress/cache/
*.tsbuildinfo
.eslintcache
.stylelintcache
coverage/
*.tgz
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 日志与运行时产物 ----------
logs/
*.log
*.pid
*.seed
*.pid.lock
/uploads/
/upload/
/temp/
/tmp/

# ---------- IDE ----------
# IDEA：保留 codeStyles 等团队共享配置，忽略个人工作区
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.settings/
.classpath
.project
.factorypath
.apt_generated/
*.sublime-workspace
*.sublime-project

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
