.page {
  padding-bottom: 24rpx;
}

.pad {
  padding: 20rpx 24rpx;
}

.item {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
}

.hd {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--action);
  flex-shrink: 0;
}

.t {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}

.c {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--ink);
}

.item-read .t {
  color: var(--muted);
  font-weight: 400;
}

.item-read .c {
  color: var(--muted);
}

.m {
  color: var(--muted);
  font-size: 22rpx;
  margin-top: 10rpx;
}
