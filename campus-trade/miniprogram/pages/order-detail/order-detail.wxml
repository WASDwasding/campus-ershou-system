<view class="page safe-bottom" wx:if="{{order.id}}">
  <view class="card box">
    <view class="st-wrap">
      <text class="pill {{order.statusClass}}">{{order.statusLabel}}</text>
    </view>
    <view class="t">{{order.goodsTitle}}</view>
    <view class="price-lg amt">¥{{order.amountText}}</view>
    <view class="meta-list">
      <view class="m">订单号 {{order.orderNo}}</view>
      <view class="m">我是{{order.myRole === 'SELLER' ? '卖家' : '买家'}}</view>
      <view class="m" wx:if="{{order.paymentLabel}}">支付 {{order.paymentLabel}}</view>
      <view class="m" wx:if="{{order.paymentReason}}">{{order.paymentReason}}</view>
      <view class="m" wx:if="{{order.expireAt}}">支付截止 {{order.expireText}}</view>
      <view class="m" wx:if="{{order.handoverText}}">{{order.handoverText}}</view>
      <view class="m" wx:if="{{order.disputeText}}">{{order.disputeText}}</view>
    </view>
    <view class="hint stage-hint" wx:if="{{order.status === 'PENDING_PAY'}}">支付完成并进入待面交后才能聊天</view>
    <view class="hint stage-hint" wx:elif="{{order.status === 'PAID' || order.status === 'DISPUTED'}}">面交时间和校内地点在本单聊天里约定。已支付后不能取消。</view>
    <view class="hint stage-hint" wx:elif="{{order.status === 'COMPLETED' || order.status === 'CANCELLED'}}">订单已结束，只能查看聊天记录，不能再发消息。</view>
  </view>

  <view class="actions">
    <!-- 主按钮：模拟付款、确认面交 -->
    <view class="btn btn-primary" wx:if="{{can.PAY}}" bindtap="pay">
      <image class="btn-ico" src="/images/btns/pri-buy.png" mode="aspectFit" />
      <text>模拟付款</text>
    </view>
    <view class="btn btn-primary" wx:if="{{can.CONFIRM_HANDOVER}}" bindtap="handover">
      <image class="btn-ico" src="/images/btns/pri-confirm.png" mode="aspectFit" />
      <text>确认已面交</text>
    </view>

    <!-- 次按钮：聊天、撤回申诉 -->
    <view class="btn btn-ghost" wx:if="{{order.status === 'PAID' || order.status === 'DISPUTED'}}" bindtap="openChat">
      <image class="btn-ico" src="/images/btns/chat-order.png" mode="aspectFit" />
      <text>本单聊天</text>
    </view>
    <view class="btn btn-ghost" wx:if="{{order.status === 'COMPLETED' || order.status === 'CANCELLED'}}" bindtap="openChat">
      <image class="btn-ico" src="/images/btns/chat-order.png" mode="aspectFit" />
      <text>查看聊天记录</text>
    </view>
    <view class="btn btn-ghost" wx:if="{{can.WITHDRAW_DISPUTE}}" bindtap="withdraw">
      <image class="btn-ico" src="/images/btns/retry-undo.png" mode="aspectFit" />
      <text>撤回申诉</text>
    </view>

    <!-- 柔樱警示立体按钮：申诉、取消订单 -->
    <view class="btn btn-warn" wx:if="{{can.OPEN_DISPUTE}}" bindtap="openDispute">
      <image class="btn-ico" src="/images/btns/warn-action.png" mode="aspectFit" />
      <text>申诉</text>
    </view>
    <view class="btn btn-warn" wx:if="{{can.CANCEL}}" bindtap="cancel">
      <image class="btn-ico" src="/images/btns/warn-action.png" mode="aspectFit" />
      <text>取消订单</text>
    </view>
  </view>
</view>
<view class="load-fail" wx:elif="{{error}}">
  <text>{{error}}</text>
  <view class="retry" bindtap="load">
    <image class="retry-ico" src="/images/btns/retry-undo.png" mode="aspectFit" />
    <text>重试</text>
  </view>
</view>
