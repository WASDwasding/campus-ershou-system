.page {
  padding-bottom: 40rpx;
}

.box {
  margin: 24rpx;
  padding: 32rpx 28rpx;
}

.st-wrap {
  margin-bottom: 16rpx;
}

.t {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}

.amt {
  margin-top: 12rpx;
}

.meta-list {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.m {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.m:first-child {
  margin-top: 0;
}

.stage-hint {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 24rpx;
}
