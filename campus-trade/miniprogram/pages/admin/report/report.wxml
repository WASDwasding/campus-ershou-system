<view class="page" wx:if="{{item.id}}">
  <view class="card box">
    <view class="t">商品 {{item.goodsId}} · {{item.statusLabel}}</view>
    <text class="copy">{{item.description}}</text>
    <view class="shots" wx:if="{{item.evidence.length}}">
      <image wx:for="{{item.evidence}}" wx:key="fileId" class="shot" src="{{item.thumbUrl || item.url}}" mode="aspectFill" data-src="{{item.url}}" bindtap="preview" />
    </view>
    <view class="hint" wx:else>没有上传凭证</view>
    <view class="m" wx:if="{{item.handleReason}}">处理理由：{{item.handleReason}}</view>
  </view>
  <view class="card box" wx:if="{{item.pending}}">
    <view class="label">处理理由（2–100 字，两种结果都要写）</view>
    <textarea class="area" maxlength="100" value="{{reason}}" bindinput="onReason" />
    <view class="btn btn-ghost" data-action="DISMISS" bindtap="handle">
      <image class="btn-ico" src="/images/btns/retry-undo.png" mode="aspectFit" />
      <text>驳回</text>
    </view>
    <view class="btn btn-warn" data-action="REMOVE_GOODS" bindtap="handle">
      <image class="btn-ico" src="/images/btns/warn-action.png" mode="aspectFit" />
      <text>下架商品</text>
    </view>
  </view>
</view>
