<view class="page" wx:if="{{item.id}}">
  <view class="card box">
    <view class="t">商品 {{item.goodsId}} · {{item.statusLabel}}</view>
    <text class="m">{{item.description}}</text>
    <view class="m" wx:if="{{item.evidenceCount}}">凭证 {{item.evidenceCount}} 张</view>
    <view class="m" wx:if="{{item.handleReason}}">处理理由：{{item.handleReason}}</view>
  </view>
  <view class="card box" wx:if="{{item.pending}}">
    <view class="label">处理理由（2–100 字，两种结果都要写）</view>
    <textarea class="area" maxlength="100" value="{{reason}}" bindinput="onReason" />
    <view class="btn btn-ghost" data-action="DISMISS" bindtap="handle">驳回</view>
    <view class="btn btn-warn" data-action="REMOVE_GOODS" bindtap="handle">下架商品</view>
  </view>
</view>
