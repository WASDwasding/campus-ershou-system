<view class="page">
  <view class="card box">
    <view class="t">修改密码</view>
    <view class="hint" wx:if="{{forced}}">当前是初始密码，改完之前不能处理业务。</view>
    <view class="hint">新密码至少 12 位。修改后需要重新登录。</view>
    <view class="label">原密码</view>
    <input class="inp" password maxlength="64" value="{{oldPassword}}" bindinput="onOld" />
    <view class="label">新密码</view>
    <input class="inp" password maxlength="64" value="{{newPassword}}" bindinput="onNew" />
    <view class="btn btn-primary" bindtap="submit">保存</view>
  </view>
</view>
