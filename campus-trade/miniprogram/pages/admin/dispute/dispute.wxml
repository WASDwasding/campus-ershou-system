<view class="page" wx:if="{{order.orderNo}}">
  <view class="card box">
    <view class="t">{{order.goodsTitle}}</view>
    <view class="price">¥{{order.amountText}}</view>
    <view class="m">订单 {{order.orderNo}} · {{order.orderStatusLabel}}</view>
    <view class="m" wx:if="{{order.paymentLabel}}">支付 {{order.paymentLabel}}</view>
    <view class="m" wx:if="{{order.paymentReason}}">{{order.paymentReason}}</view>
    <view class="m">申诉 {{order.disputeStatusLabel}} · {{order.reasonLabel}}</view>
    <view class="m">{{order.description}}</view>
    <view class="m">{{order.handoverText}}</view>
    <view class="m" wx:if="{{order.resultLabel}}">结案 {{order.resultLabel}} {{order.remark}}</view>
  </view>
  <view class="card box">
    <view class="section-title">下单快照</view>
    <view class="shots" wx:if="{{order.snapshot.length}}">
      <image wx:for="{{order.snapshot}}" wx:key="fileId" class="shot" src="{{item.thumbUrl || item.url}}" mode="aspectFill" data-group="snapshot" data-src="{{item.url}}" bindtap="preview" />
    </view>
    <view class="m" wx:if="{{order.conditionLabel || order.categoryName || order.meetupName}}">{{order.conditionLabel}} {{order.categoryName}} {{order.meetupName}}</view>
    <text class="copy" wx:if="{{order.goodsDescription}}">{{order.goodsDescription}}</text>
    <view class="m" wx:if="{{order.tradeNote}}">交易说明：{{order.tradeNote}}</view>
    <view class="m" wx:if="{{order.aliasText}}">也叫：{{order.aliasText}}</view>
    <view class="hint" wx:if="{{!order.snapshot.length && !order.goodsDescription}}">这张订单没有快照内容。</view>
  </view>
  <view class="card box">
    <view class="section-title">申诉材料</view>
    <view class="shots" wx:if="{{order.evidence.length}}">
      <image wx:for="{{order.evidence}}" wx:key="fileId" class="shot" src="{{item.thumbUrl || item.url}}" mode="aspectFill" data-group="evidence" data-src="{{item.url}}" bindtap="preview" />
    </view>
    <view class="hint" wx:else>没有上传图片</view>
  </view>
  <view class="card box">
    <view class="section-title">聊天记录</view>
    <view class="hint">{{chatHint}}</view>
    <view class="bubble" wx:for="{{messages}}" wx:key="id">
      <text>{{item.who}}：{{item.content}}</text>
    </view>
  </view>
  <view class="card box" wx:if="{{order.open}}">
    <view class="label">结案说明（2–300 字，双方可见）</view>
    <textarea class="area" maxlength="300" value="{{remark}}" bindinput="onRemark" />
    <view class="hint" wx:if="{{!order.bothConfirmed}}">继续完成需要买卖双方都已确认面交。</view>
    <view class="btn btn-primary" data-result="REJECT" bindtap="resolve">
      <image class="btn-ico" src="/images/btns/pri-confirm.png" mode="aspectFit" />
      <text>驳回</text>
    </view>
    <view class="btn btn-ghost" data-result="COMPLETE" bindtap="resolve">
      <image class="btn-ico" src="/images/btns/retry-undo.png" mode="aspectFit" />
      <text>继续完成</text>
    </view>
    <view class="btn btn-warn" data-result="CANCEL" bindtap="resolve">
      <image class="btn-ico" src="/images/btns/warn-action.png" mode="aspectFit" />
      <text>取消订单</text>
    </view>
  </view>
</view>
