<view class="page">
  <view class="card box">
    <view class="t">{{name || '管理员'}}</view>
    <view class="hint">只能审核、结案和下架。不能代学生发聊天。</view>
  </view>
  <view class="card menu">
    <view class="mi" bindtap="go" data-url="/pages/admin/verifications/verifications">校园认证</view>
    <view class="mi" bindtap="go" data-url="/pages/admin/disputes/disputes">订单申诉</view>
    <view class="mi" bindtap="go" data-url="/pages/admin/reports/reports">商品举报</view>
    <view class="mi" bindtap="go" data-url="/pages/admin/password/password">修改密码</view>
  </view>
  <view class="btn btn-warn" bindtap="logout">
    <image class="btn-ico" src="/images/btns/warn-action.png" mode="aspectFit" />
    <text>退出管理端</text>
  </view>
</view>
