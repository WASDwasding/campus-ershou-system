<view class="page">
  <view class="tabs">
    <view class="chip {{status === item.id ? 'chip-on' : ''}}" wx:for="{{tabs}}" wx:key="id" bindtap="setStatus" data-id="{{item.id}}">{{item.label}}</view>
  </view>
  <view class="card item" wx:for="{{list}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
    <view class="t">{{item.name}} · {{item.statusLabel}}</view>
    <view class="m" wx:if="{{item.dormName}}">宿舍 {{item.dormName}}</view>
    <view class="m">{{item.timeText}}</view>
  </view>
  <view class="empty" wx:if="{{!list.length}}">
    <image class="empty-illust" src="/images/empty/order.png" mode="aspectFit" />
    <view class="empty-text">没有申请</view>
  </view>
</view>
