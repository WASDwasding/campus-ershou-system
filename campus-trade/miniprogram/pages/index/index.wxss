.page {
  padding-bottom: 24rpx;
}

.nav {
  padding-left: 28rpx;
  padding-bottom: 12rpx;
}

.nav-row {
  display: flex;
  align-items: center;
}

.brand-logo {
  width: 92rpx;
  height: 58rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.15;
}

.brand-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
  line-height: 1.2;
}

.search {
  position: sticky;
  z-index: 5;
  margin: 16rpx 24rpx 4rpx;
  height: 80rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 8rpx 24rpx rgba(46, 65, 80, 0.05);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  backdrop-filter: blur(20px) saturate(160%);
}

.search-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.ph {
  color: var(--muted);
  font-size: 26rpx;
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 12rpx 4rpx;
}

.cat {
  width: 25%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
}

.cat-tile {
  width: 96rpx;
  height: 96rpx;
}

.cat-name {
  position: relative;
  margin-top: 10rpx;
  padding-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.2;
}

.cat-on .cat-name {
  color: var(--action);
  font-weight: 600;
}

.cat-on .cat-name::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--action);
}

.banner-wrap {
  margin: 12rpx 24rpx 4rpx;
}

.banner {
  display: block;
  width: 100%;
}

.sorts {
  display: flex;
  align-items: flex-end;
  gap: 36rpx;
  padding: 24rpx 32rpx 8rpx;
}

.sort {
  position: relative;
  padding-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 400;
  color: var(--muted);
  line-height: 1.2;
}

.sort-on {
  color: var(--ink);
  font-weight: 600;
}

.sort-on::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--ink);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 16rpx;
}

.cell {
  width: 50%;
  box-sizing: border-box;
  padding: 10rpx;
}

.pad {
  padding: 16rpx 28rpx;
  text-align: center;
}
