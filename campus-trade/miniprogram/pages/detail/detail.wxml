<view class="wrap">
  <page-nav
    title="商品详情"
    back="{{true}}"
    leftText="{{item.id ? '举报' : ''}}"
    leftIcon="{{item.id ? '/images/btns/warn-action.png' : ''}}"
    leftTone="warn"
    bind:left="report"
  />

  <view class="page" wx:if="{{item.id}}">
    <view class="cover">
      <swiper
        wx:if="{{item.imageUrls.length}}"
        class="sw"
        indicator-dots="{{item.imageUrls.length > 1}}"
        indicator-color="rgba(46, 65, 80, 0.2)"
        indicator-active-color="#3E7EA3"
      >
        <swiper-item wx:for="{{item.imageThumbs}}" wx:key="*this" wx:for-item="img" wx:for-index="i">
          <image src="{{img}}" mode="aspectFill" class="img" lazy-load bindtap="preview" data-src="{{item.imageUrls[i]}}" />
        </swiper-item>
      </swiper>
      <image wx:else class="cover-mark" src="/images/brand-mark.png" mode="aspectFit" />
    </view>

    <view class="card main">
      <view class="price-row">
        <text class="price-lg">¥{{item.priceText}}</text>
        <text class="tag" wx:if="{{item.conditionLabel}}">{{item.conditionLabel}}</text>
        <text class="orig-price" wx:if="{{item.originalPriceText}}">¥{{item.originalPriceText}}</text>
      </view>
      <view class="title">{{item.title}}</view>
      <view class="attrs">{{item.categoryName || ''}}{{item.categoryName && item.meetupName ? ' · ' : ''}}{{item.meetupName || ''}}{{(item.categoryName || item.meetupName) && item.statusLabel ? ' · ' : ''}}{{item.statusLabel || ''}}</view>
    </view>

    <view class="card block">
      <view class="section-title">描述</view>
      <text class="desc">{{item.description || '卖家没有填写描述'}}</text>
      <view class="hint extra-line" wx:if="{{item.tradeNote}}">交易说明：{{item.tradeNote}}</view>
      <view class="hint extra-line" wx:if="{{item.aliasText}}">也叫：{{item.aliasText}}</view>
    </view>

    <view class="card block">
      <view class="section-title">建议价</view>
      <view class="btn btn-ai quote-btn" hover-class="btn-ai-press" bindtap="loadQuote">
        <image class="ai-ico" src="/images/icons/ai-sparkle.png" mode="aspectFit" />
        <text>看建议价</text>
      </view>
      <view class="quote-res" wx:if="{{quote.available}}">
        <text class="price">¥{{quote.priceText}}</text>
        <text class="pill pill-cream">{{quote.disclaimer || '仅供参考'}}</text>
      </view>
      <view wx:elif="{{quote}}" class="hint quote-hint">{{quote.hint}}</view>
      <view class="hint quote-note">建议价不能作为成交价，下单仍按卖家标价。</view>
    </view>

    <view class="card block seller" bindtap="openSeller">
      <view class="seller-left">
        <image class="seller-ava" src="{{item.sellerAvatar || '/images/default-avatar.png'}}" mode="aspectFill" binderror="onSellerAvatarErr" />
        <view class="seller-info">
          <view class="sn">{{item.sellerName}}</view>
          <view class="seller-sub">{{item.seller.verified ? '已认证' : '未认证'}}</view>
        </view>
      </view>
      <text class="arr">›</text>
    </view>

    <view class="hint removed" wx:if="{{item.removedReason}}">下架原因：{{item.removedReason}}</view>
    <view class="hint removed" wx:if="{{blockReason}}">{{blockReason}}</view>

    <view class="bar">
      <view class="btn btn-ghost grow" wx:if="{{item.viewer.activeOrderId}}" bindtap="openOrder">
        <image class="btn-ico" src="/images/btns/chat-order.png" mode="aspectFit" />
        <text>查看订单</text>
      </view>
      <view class="btn btn-edit-soft grow" wx:elif="{{item.viewer.isMine}}" bindtap="edit">
        <image class="btn-ico" src="/images/btns/op-edit.png" mode="aspectFit" />
        <text>编辑</text>
      </view>
      <view class="btn btn-primary grow" wx:elif="{{item.viewer.canBuy}}" bindtap="buy">
        <image class="btn-ico" src="/images/btns/pri-buy.png" mode="aspectFit" />
        <text>下单</text>
      </view>
      <view class="btn btn-disabled grow" wx:else>{{item.statusLabel || '暂不可下单'}}</view>
    </view>
  </view>

  <view class="load-fail" wx:elif="{{error}}">
    <text>{{error}}</text>
    <view class="retry" bindtap="load">
      <image class="retry-ico" src="/images/btns/retry-undo.png" mode="aspectFit" />
      <text>重试</text>
    </view>
  </view>
</view>
