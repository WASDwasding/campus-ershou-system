.page {
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
}

.cover {
  width: 750rpx;
  height: 750rpx;
  background: var(--soft);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  overflow: hidden;
}

.sw,
.img {
  width: 750rpx;
  height: 750rpx;
  border-radius: 0;
}

.cover-mark {
  width: 180rpx;
  height: 112rpx;
  opacity: 0.35;
}

.main {
  margin: 20rpx 24rpx 16rpx;
  padding: 28rpx;
}

.price-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.orig-price {
  font-size: 22rpx;
  color: var(--muted);
  text-decoration: line-through;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  margin: 16rpx 0 10rpx;
}

.attrs {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--muted);
}

.block {
  margin: 0 24rpx 16rpx;
  padding: 28rpx;
}

.desc {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.extra-line {
  margin-top: 12rpx;
}

.quote-btn {
  margin-top: 4rpx;
}

.quote-res {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.quote-hint {
  margin-top: 16rpx;
}

.quote-note {
  margin-top: 16rpx;
}

.seller {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.seller-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
}

.seller-ava {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--soft);
  color: var(--action);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.seller-info {
  min-width: 0;
  flex: 1;
}

.sn {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seller-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.arr {
  font-size: 26rpx;
  color: var(--muted);
  margin-left: 16rpx;
}

.removed {
  padding: 4rpx 32rpx 12rpx;
  color: var(--muted);
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
}

.grow {
  flex: 1;
}
