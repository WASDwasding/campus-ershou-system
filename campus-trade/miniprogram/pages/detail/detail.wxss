.cover { height: 420rpx; background: #efe8dc; display: flex; align-items: center; justify-content: center; }
.sw, .img { width: 100%; height: 420rpx; }
.big { font-size: 120rpx; }
.main { margin: -32rpx 24rpx 16rpx; padding: 28rpx; position: relative; }
.lg { font-size: 44rpx; }
.title { font-size: 34rpx; font-weight: 700; margin: 12rpx 0 8rpx; }
.block { margin: 0 24rpx 16rpx; padding: 24rpx; }
.seller { display: flex; justify-content: space-between; align-items: center; }
.sn { font-weight: 700; }
.removed { padding: 0 32rpx 16rpx; color: #b36b12; }
.bar {
  position: sticky;
  bottom: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fff8ee;
}
.iconbtn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grow { flex: 1; }
