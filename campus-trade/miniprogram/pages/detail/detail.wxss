.page {
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
}

.cover {
  width: 750rpx;
  height: 750rpx;
  background: var(--soft);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  overflow: hidden;
}

.sw,
.img {
  width: 750rpx;
  height: 750rpx;
  border-radius: 0;
}

.cover-mark {
  width: 192rpx;
  height: 120rpx;
  opacity: 0.62;
  filter: drop-shadow(0 6rpx 14rpx rgba(62, 126, 163, 0.14));
}

.main {
  margin: 20rpx 24rpx 16rpx;
  padding: 28rpx;
}

.price-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.orig-price {
  font-size: 22rpx;
  color: var(--muted);
  text-decoration: line-through;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  margin: 16rpx 0 10rpx;
}

.attrs {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--muted);
}

.block {
  margin: 0 24rpx 16rpx;
  padding: 28rpx;
}

.desc {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.extra-line {
  margin-top: 12rpx;
}

.quote-btn {
  margin-top: 4rpx;
}

.quote-res {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.quote-hint {
  margin-top: 16rpx;
}

.quote-note {
  margin-top: 16rpx;
}

.seller {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.seller-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
}

.seller-ava {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-sizing: border-box;
  background: var(--soft);
  border: 3rpx solid #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(46, 65, 80, 0.09);
}

.seller-info {
  min-width: 0;
  flex: 1;
}

.sn {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seller-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.arr {
  font-size: 34rpx;
  line-height: 1;
  color: var(--muted);
  margin-left: 16rpx;
}

.removed {
  padding: 4rpx 32rpx 12rpx;
  color: var(--muted);
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.90);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(222, 236, 246, 0.9);
  box-shadow: 0 -6rpx 20rpx rgba(46, 65, 80, 0.04);
}

.btn-edit-soft {
  background: linear-gradient(180deg, #fffdf4 0%, #f9ecc4 100%);
  color: #6b531d;
  border: 1rpx solid rgba(226, 200, 130, 0.8);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.96),
    0 8rpx 20rpx rgba(188, 148, 52, 0.13);
}

.btn-edit-soft:active {
  transform: scale(0.975) translateY(1rpx);
}

.grow {
  flex: 1;
}
