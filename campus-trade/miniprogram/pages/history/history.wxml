<view class="page">
  <view class="pad" wx:if="{{list.length}}"><view class="chip" bindtap="clear">清空记录</view></view>
  <view class="grid">
    <view class="cell" wx:for="{{list}}" wx:key="id">
      <product-card item="{{item}}" bind:open="open" />
    </view>
  </view>
  <view class="empty" wx:if="{{!list.length}}">还没有浏览记录</view>
</view>
