<view class="page">
  <page-nav title="我的" />
  <block wx:if="{{user}}">
    <view class="card profile-card">
      <view class="profile-top">
        <image class="ava" src="{{user.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" binderror="onAvatarErr" />
        <view class="info">
          <view class="name-row">
            <view class="n">{{user.nickname || '未命名'}}</view>
            <text class="pill {{user.verifyStatus === 'VERIFIED' ? 'pill-done' : 'pill-cream'}}">{{user.verifyLabel}}</text>
          </view>
          <view class="m">{{user.studentNoMasked || '未绑定学号'}}</view>
          <view class="m" wx:if="{{user.campusLine}}">{{user.campusLine}}</view>
          <view class="ban-tip" wx:if="{{user.publishBanned}}">已禁止再发布，仍可登录和购买</view>
        </view>
      </view>
      <view class="stats">
        <view class="s"><text class="num">{{stats.onSale || 0}}</text>在售</view>
        <view class="s"><text class="num">{{stats.sold || 0}}</text>卖出</view>
        <view class="s"><text class="num">{{stats.pending || 0}}</text>待支付</view>
        <view class="s"><text class="num">{{stats.selling || 0}}</text>进行中</view>
      </view>
    </view>

    <view class="card menu">
      <view class="menu-hd">交易</view>
      <view class="mi" hover-class="mi-press" hover-start-time="0" hover-stay-time="70" bindtap="go" data-url="/pages/my-goods/my-goods">
        <view class="mi-left">
          <image class="mi-ico" src="/images/menu/goods.png" mode="aspectFit" />
          <text class="mi-label">我的商品</text>
        </view>
        <text class="arr">›</text>
      </view>
      <view class="mi" hover-class="mi-press" hover-start-time="0" hover-stay-time="70" bindtap="go" data-url="/pages/orders/orders">
        <view class="mi-left">
          <image class="mi-ico" src="/images/menu/orders.png" mode="aspectFit" />
          <text class="mi-label">买入和卖出订单</text>
        </view>
        <text class="arr">›</text>
      </view>
      <view class="mi" hover-class="mi-press" hover-start-time="0" hover-stay-time="70" bindtap="go" data-url="/pages/reports/reports">
        <view class="mi-left">
          <image class="mi-ico" src="/images/menu/reports.png" mode="aspectFit" />
          <text class="mi-label">我的举报</text>
        </view>
        <text class="arr">›</text>
      </view>
    </view>

    <view class="card menu">
      <view class="menu-hd">账号</view>
      <view class="mi" hover-class="mi-press" hover-start-time="0" hover-stay-time="70" bindtap="go" data-url="/pages/verify/verify">
        <view class="mi-left">
          <image class="mi-ico" src="/images/menu/verify.png" mode="aspectFit" />
          <text class="mi-label">校园认证</text>
        </view>
        <text class="arr">›</text>
      </view>
      <view class="mi" hover-class="mi-press" hover-start-time="0" hover-stay-time="70" bindtap="go" data-url="/pages/settings/settings">
        <view class="mi-left">
          <image class="mi-ico" src="/images/menu/settings.png" mode="aspectFit" />
          <text class="mi-label">编辑资料</text>
        </view>
        <text class="arr">›</text>
      </view>
      <view class="mi" wx:if="{{!user.wxBound}}" hover-class="mi-press" hover-start-time="0" hover-stay-time="70" bindtap="bindWx">
        <view class="mi-left">
          <image class="mi-ico" src="/images/menu/wechat.png" mode="aspectFit" />
          <text class="mi-label">绑定微信</text>
        </view>
        <text class="arr">›</text>
      </view>
      <view class="mi" wx:else>
        <view class="mi-left">
          <image class="mi-ico" src="/images/menu/wechat.png" mode="aspectFit" />
          <text class="mi-label">绑定微信</text>
        </view>
        <view class="mi-right">
          <text class="mi-sub">已绑定</text>
          <text class="arr">›</text>
        </view>
      </view>
    </view>

    <view class="btn btn-warn out" bindtap="logout">
      <image class="btn-ico" src="/images/btns/warn-action.png" mode="aspectFit" />
      <text>退出登录</text>
    </view>
  </block>
</view>
