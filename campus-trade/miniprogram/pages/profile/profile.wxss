.page {
  padding-bottom: 32rpx;
}

.profile-card {
  margin: 20rpx 24rpx 20rpx;
  padding: 32rpx 24rpx 24rpx;
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 4rpx;
}

.ava {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-sizing: border-box;
  background: var(--soft);
  border: 4rpx solid #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(46, 65, 80, 0.10);
}

.info {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.n {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.25;
}

.m {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
  margin-top: 6rpx;
}

.ban-tip {
  font-size: 22rpx;
  color: var(--danger);
  margin-top: 6rpx;
}

.stats {
  display: flex;
  margin-top: 28rpx;
  background: var(--bg);
  border-radius: 18rpx;
  padding: 20rpx 0;
}

.s {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}

.num {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.25;
  margin-bottom: 4rpx;
}

.menu {
  margin: 0 24rpx 20rpx;
  overflow: hidden;
}

.menu-hd {
  padding: 24rpx 28rpx 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
}

.mi {
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--line);
  font-size: 30rpx;
  font-weight: 400;
  color: var(--ink);
  transition: background-color 0.15s ease;
}

.mi-press {
  background-color: rgba(232, 244, 250, 0.65);
}

.mi:last-child {
  border-bottom: none;
}

.mi-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.mi-ico {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 4rpx 10rpx rgba(46, 65, 80, 0.11));
}

.mi-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mi-sub {
  font-size: 22rpx;
  color: var(--muted);
}

.arr {
  font-size: 34rpx;
  line-height: 1;
  color: var(--muted);
}

.out {
  margin: 28rpx 24rpx 0;
}
