.box {
  margin: 24rpx;
  padding: 28rpx;
}

.st {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.label {
  margin: 20rpx 0 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.inp {
  display: block;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--soft);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.input-placeholder {
  color: var(--muted);
  line-height: 84rpx;
}

.box .btn {
  margin-top: 20rpx;
}

.box .hint {
  margin-top: 10rpx;
}
