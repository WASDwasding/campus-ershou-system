<view class="page">
  <view class="card box">
    <view class="st">当前状态：{{statusLabel}}</view>
    <view class="hint" wx:if="{{status === 'VERIFIED'}}">已通过，可以发布和下单。</view>
    <view class="hint" wx:if="{{status === 'PENDING'}}">审核中，请等待管理员处理。</view>
    <view class="hint" wx:if="{{rejectReason}}">驳回原因：{{rejectReason}}</view>
    <block wx:if="{{status === 'UNVERIFIED' || status === 'REJECTED'}}">
      <view class="label">姓名</view>
      <input class="inp" maxlength="20" placeholder="1–20 字" value="{{realName}}" bindinput="onRealName" />
      <view class="label">学号</view>
      <input class="inp" type="number" maxlength="12" placeholder="须与注册学号一致" value="{{studentNo}}" bindinput="onStudentNo" />
      <view class="label">学院</view>
      <input class="inp" maxlength="30" placeholder="1–30 字" value="{{college}}" bindinput="onCollege" />
      <view class="label">宿舍楼</view>
      <picker range="{{dormNames}}" bindchange="onDorm">
        <view class="inp">{{dormNames[dormIndex] || '请选择'}}</view>
      </picker>
      <view class="btn btn-ghost" bindtap="card">
        <image class="btn-ico" src="/images/btns/camera-upload.png" mode="aspectFit" />
        <text>{{fileId ? '证件照已上传' : '上传校园卡照片'}}</text>
      </view>
      <view class="hint">证件照只给审核使用，审核结束后按平台规则删除。学号使用注册时绑定的学号。</view>
      <view class="btn btn-primary" bindtap="submit">
        <image class="btn-ico" src="/images/btns/pri-confirm.png" mode="aspectFit" />
        <text>提交认证</text>
      </view>
    </block>
  </view>
</view>
