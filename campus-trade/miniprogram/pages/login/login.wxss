page {
  min-height: 100%;
  background: var(--bg);
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.hero {
  text-align: center;
  color: var(--ink);
  margin-bottom: 44rpx;
}

.logo-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.logo {
  width: 200rpx;
  height: 125rpx;
  display: block;
}

.name {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ink);
  margin-top: 20rpx;
  line-height: 1.2;
}

.form {
  padding: 36rpx;
}

.tabs {
  display: flex;
  background: var(--bg);
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 14rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 400;
}

.tab.on {
  background: var(--card);
  color: var(--ink);
  font-weight: 600;
}

.label {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
  margin: 16rpx 0 8rpx;
}

.inp {
  display: block;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  box-sizing: border-box;
  background: var(--soft);
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 4rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.input-placeholder {
  color: var(--muted);
  line-height: 84rpx;
}

.submit-btn {
  margin-top: 32rpx;
}

.or-line {
  text-align: center;
  margin: 20rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}

.wx-btn {
  margin-top: 0;
}

.step {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.link {
  text-align: center;
  color: var(--action);
  font-size: 26rpx;
  margin-top: 24rpx;
}

.link.off {
  color: var(--muted);
}

.foot-note {
  margin-top: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
