page {
  min-height: 100%;
  background: #f3f8fc;
}
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 80rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}
.hero {
  text-align: center;
  color: #2e4150;
  margin-bottom: 40rpx;
}
.logo-wrap {
  width: 240rpx;
  height: 240rpx;
  margin: 0 auto;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(46, 65, 80, 0.08);
}
.logo {
  width: 240rpx;
  height: 240rpx;
  display: block;
}
.name {
  font-size: 48rpx;
  font-weight: 800;
  margin-top: 12rpx;
}
.sub {
  font-size: 24rpx;
  color: #7d8f9c;
  margin-top: 8rpx;
}
.form {
  padding: 36rpx;
}
.label {
  font-size: 24rpx;
  color: #7d8f9c;
  margin: 12rpx 0 8rpx;
}
.inp {
  height: 84rpx;
  background: #f3f8fc;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 8rpx;
  color: #2e4150;
}
.center {
  text-align: center;
  margin-top: 16rpx;
}
.form .btn {
  margin-top: 28rpx;
}
.tabs {
  display: flex;
  background: #f3f8fc;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 8rpx;
}
.tab {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 12rpx;
  color: #7d8f9c;
  font-size: 28rpx;
}
.tab.on {
  background: #fff;
  color: #4f90b8;
  font-weight: 700;
}
.step {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.link {
  text-align: center;
  color: #4f90b8;
  font-size: 26rpx;
  margin-top: 20rpx;
}
.link.off {
  color: #7d8f9c;
}
.demo {
  margin-top: 36rpx;
}
.demo-title {
  font-size: 24rpx;
  color: #7d8f9c;
  margin-bottom: 12rpx;
}
.demo-row {
  display: flex;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}
.who {
  color: #7d8f9c;
}
