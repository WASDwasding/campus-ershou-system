page {
  min-height: 100%;
  background: var(--bg);
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.hero {
  text-align: center;
  color: var(--ink);
  margin-bottom: 44rpx;
}

.logo-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.logo {
  width: 172rpx;
  height: 172rpx;
  display: block;
  filter: drop-shadow(0 16rpx 32rpx rgba(46, 65, 80, 0.12)) drop-shadow(0 4rpx 10rpx rgba(62, 126, 163, 0.08));
}

.name {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ink);
  margin-top: 20rpx;
  line-height: 1.2;
}

.form {
  padding: 36rpx;
}

.tabs {
  display: flex;
  background: #eaf3f9;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 18rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(46, 65, 80, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 15rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 500;
  transition: background 0.18s ease, box-shadow 0.18s ease, color 0.18s ease;
}

.tab.on {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbfe 100%);
  color: var(--ink);
  font-weight: 600;
  box-shadow:
    inset 0 2rpx 0 #ffffff,
    0 4rpx 12rpx rgba(46, 65, 80, 0.08);
}

.label {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
  margin: 16rpx 0 8rpx;
}

.inp {
  display: block;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  box-sizing: border-box;
  background: var(--soft);
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 4rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.input-placeholder {
  color: var(--muted);
  line-height: 84rpx;
}

.submit-btn {
  margin-top: 32rpx;
}

.or-line {
  text-align: center;
  margin: 20rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}

.wx-btn {
  margin-top: 0;
}

.step {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.link {
  text-align: center;
  color: var(--action);
  font-size: 26rpx;
  margin-top: 24rpx;
}

.link.off {
  color: var(--muted);
}

.foot-note {
  margin-top: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
