.page {
  padding-bottom: 32rpx;
}

.page-with-bar {
  padding-bottom: 164rpx;
}

.box {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
}

.ph {
  width: 164rpx;
  height: 164rpx;
  border-radius: 26rpx;
  overflow: hidden;
  position: relative;
  background: var(--soft);
  box-shadow: 0 6rpx 16rpx rgba(46, 65, 80, 0.06);
}

.ph-img {
  width: 100%;
  height: 100%;
}

.add {
  background: transparent;
  overflow: visible;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.16s ease;
}

.add-tile {
  width: 164rpx;
  height: 164rpx;
  display: block;
  filter: drop-shadow(0 8rpx 20rpx rgba(62, 126, 163, 0.16)) drop-shadow(0 2rpx 6rpx rgba(46, 65, 80, 0.06));
}

.add-press {
  transform: scale(0.94);
  opacity: 0.92;
}

.x {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.x-press {
  transform: scale(0.9);
}

.x-ico {
  width: 44rpx;
  height: 44rpx;
  display: block;
  filter: drop-shadow(0 3rpx 8rpx rgba(22, 36, 48, 0.28));
}

.label {
  margin: 20rpx 0 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 400;
}

.first-label {
  margin-top: 8rpx;
}

.inp {
  display: block;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--soft);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.inp-ph {
  color: var(--muted);
  font-size: 26rpx;
  line-height: 84rpx;
}

.pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.pick-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.loc-ico {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  display: block;
}

.pick-val {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-arr {
  font-size: 32rpx;
  line-height: 1;
  color: var(--muted);
  flex-shrink: 0;
}

.area {
  display: block;
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
  background: var(--soft);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.price-field {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  background: var(--soft);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.price-prefix {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--ink);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.price-inp {
  display: block;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
}

.price-ph {
  font-size: 30rpx;
  font-weight: 400;
  line-height: 96rpx;
  color: var(--muted);
}

.card-btn {
  margin-top: 24rpx;
}

.draft-hint {
  margin-top: 14rpx;
}

.pub-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.90);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(222, 236, 246, 0.9);
  box-shadow: 0 -6rpx 20rpx rgba(46, 65, 80, 0.04);
}
