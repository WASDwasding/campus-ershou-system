<view class="page" style="{{kbHeight ? 'padding-bottom: ' + kbHeight + 'px;' : ''}}">
  <scroll-view class="msgs" scroll-y scroll-into-view="{{anchor}}" bindtap="dismissKeyboard">
    <view class="msgs-inner">
      <view class="more" wx:if="{{hasMore}}" catchtap="older">更早的消息</view>
      <view class="hint pad" wx:if="{{hint}}">{{hint}}</view>

      <view id="m{{item.id}}" class="msg {{item.mine ? 'mine' : 'peer'}}" wx:for="{{messages}}" wx:key="id">
        <block wx:if="{{!item.mine}}">
          <image class="ava" src="{{peerAvatar || '/images/default-avatar.png'}}" mode="aspectFill" binderror="onPeerAvatarErr" />
          <view class="bubble">
            <text class="bubble-text">{{item.content}}</text>
          </view>
        </block>

        <block wx:else>
          <view class="bubble">
            <text class="bubble-text">{{item.content}}</text>
          </view>
          <image class="ava ava-mine" src="{{myAvatar || '/images/default-avatar.png'}}" mode="aspectFill" binderror="onMyAvatarErr" />
        </block>
      </view>

      <view id="end" class="end-anchor"></view>
    </view>
  </scroll-view>

  <view class="inputbar {{kbHeight ? 'kb-open' : ''}}" catchtouchmove="noop">
    <input
      class="inp"
      maxlength="500"
      value="{{text}}"
      bindinput="onText"
      confirm-type="send"
      bindconfirm="send"
      adjust-position="{{false}}"
      hold-keyboard="{{true}}"
      bindkeyboardheightchange="onKeyboard"
      disabled="{{!canSend}}"
      placeholder="{{canSend ? '约定面交时间和校内地点' : hint}}"
      placeholder-class="input-placeholder"
    />
    <view class="btn btn-primary send" bindtap="send">
      <image class="btn-ico-sm" src="/images/btns/pri-send.png" mode="aspectFit" />
      <text>发送</text>
    </view>
  </view>
</view>
