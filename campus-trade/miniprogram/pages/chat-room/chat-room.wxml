<view class="page">
  <scroll-view class="msgs" scroll-y scroll-into-view="{{anchor}}">
    <view class="more" wx:if="{{hasMore}}" bindtap="older">更早的消息</view>
    <view class="hint pad" wx:if="{{hint}}">{{hint}}</view>
    <view id="m{{item.id}}" class="msg {{item.mine ? 'mine' : 'peer'}}" wx:for="{{messages}}" wx:key="id">
      <view class="bubble"><text>{{item.content}}</text></view>
    </view>
    <view id="end"></view>
  </scroll-view>
  <view class="inputbar safe-bottom">
    <input class="inp" maxlength="500" value="{{text}}" bindinput="onText" confirm-type="send" bindconfirm="send" disabled="{{!canSend}}" placeholder="{{canSend ? '约定面交时间和校内地点' : hint}}" />
    <view class="btn btn-primary send" bindtap="send">发送</view>
  </view>
</view>
