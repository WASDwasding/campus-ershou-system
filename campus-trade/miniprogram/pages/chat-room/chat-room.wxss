.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg);
}

.msgs {
  flex: 1;
  height: 0;
  width: 100%;
}

.msgs-inner {
  padding: 24rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.more {
  text-align: center;
  color: var(--action);
  font-size: 22rpx;
  padding: 12rpx;
}

.pad {
  text-align: center;
  padding: 16rpx 0;
}

.msg {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  width: 100%;
  margin: 22rpx 0;
  box-sizing: border-box;
}

.msg.mine {
  justify-content: flex-end;
}

.msg.sys {
  justify-content: center;
}

.ava {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-sizing: border-box;
  background: var(--soft);
  color: var(--action);
  border: 2rpx solid var(--card);
  box-shadow: 0 4rpx 12rpx rgba(46, 65, 80, 0.06);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ava-mine {
  background: var(--soft);
  color: var(--action);
}

.bubble {
  max-width: calc(100% - 176rpx);
  min-height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: var(--card);
  color: var(--ink);
  padding: 16rpx 24rpx;
  border-radius: 8rpx 22rpx 22rpx 22rpx;
  box-shadow: 0 4rpx 12rpx rgba(46, 65, 80, 0.04);
}

.mine .bubble {
  background: var(--action);
  color: #ffffff;
  border-radius: 22rpx 8rpx 22rpx 22rpx;
  box-shadow: none;
}

.bubble-text {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
  word-break: break-all;
  white-space: pre-wrap;
}

.sys .bubble {
  background: var(--soft);
  color: var(--action);
  font-size: 22rpx;
  min-height: 0;
  border-radius: 999rpx;
  box-shadow: none;
}

.end-anchor {
  height: 8rpx;
}

.inputbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
}

.inputbar.kb-open {
  padding-top: 20rpx;
  padding-bottom: 30rpx;
}

.inputbar .inp {
  display: block;
  flex: 1;
  min-width: 0;
  height: 76rpx;
  line-height: 76rpx;
  box-sizing: border-box;
  background: var(--soft);
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.input-placeholder {
  color: var(--muted);
  line-height: 76rpx;
}

.inputbar .send {
  width: 144rpx;
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}
