<view class="page">
  <view class="card box">
    <view class="ava-row" bindtap="avatar">
      <image class="ava-preview" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" binderror="onAvatarErr" />
      <view class="ava-tip">点击更换头像</view>
    </view>
    <view class="label">昵称（1–16 字）</view>
    <input class="inp" maxlength="16" value="{{nickname}}" bindinput="onNick" />
    <view class="label">简介（60 字以内）</view>
    <textarea class="area" maxlength="60" value="{{bio}}" bindinput="onBio" />
    <view class="label">宿舍楼</view>
    <picker range="{{dormNames}}" bindchange="onDorm">
      <view class="inp">{{dormNames[dormIndex] || '请选择宿舍楼'}}</view>
    </picker>
    <view class="btn btn-ghost" bindtap="avatar">
      <image class="btn-ico" src="/images/btns/camera-upload.png" mode="aspectFit" />
      <text>上传头像</text>
    </view>
    <view class="btn btn-primary" bindtap="save">
      <image class="btn-ico" src="/images/btns/pri-publish.png" mode="aspectFit" />
      <text>保存</text>
    </view>
  </view>
</view>
