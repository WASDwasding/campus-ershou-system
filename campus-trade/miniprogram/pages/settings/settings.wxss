.box {
  margin: 24rpx;
  padding: 28rpx;
}

.ava-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 16rpx;
}

.ava-preview {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: var(--soft);
  border: 4rpx solid #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(46, 65, 80, 0.11);
}

.ava-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--action);
}

.label {
  margin: 16rpx 0 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.inp {
  display: block;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  margin-bottom: 8rpx;
  box-sizing: border-box;
  background: var(--soft);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.input-placeholder {
  color: var(--muted);
  line-height: 84rpx;
}

.area {
  display: block;
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
  line-height: 1.5;
  box-sizing: border-box;
  background: var(--soft);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.box .btn {
  margin-top: 20rpx;
}
