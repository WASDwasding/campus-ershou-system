.bar {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx 8rpx;
}

.inp {
  display: block;
  flex: 1;
  min-width: 0;
  height: 78rpx;
  line-height: 78rpx;
  box-sizing: border-box;
  background: var(--card);
  border-radius: 39rpx;
  border: 1rpx solid rgba(206, 224, 238, 0.9);
  box-shadow: inset 0 2rpx 0 #ffffff, 0 4rpx 12rpx rgba(46, 65, 80, 0.04);
  padding: 0 28rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.inp-ph {
  color: var(--muted);
  line-height: 78rpx;
}

.go {
  width: 158rpx;
  height: 78rpx;
  border-radius: 39rpx;
  font-size: 26rpx;
  gap: 8rpx;
  flex-shrink: 0;
}

.filters {
  display: flex;
  gap: 12rpx;
  padding: 10rpx 24rpx 18rpx;
}

.mini {
  display: block;
  flex: 1;
  min-width: 0;
  height: 70rpx;
  line-height: 70rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #ffffff 0%, #f5fafe 100%);
  border: 1rpx solid rgba(210, 226, 238, 0.9);
  box-shadow: inset 0 2rpx 0 #ffffff, 0 4rpx 10rpx rgba(46, 65, 80, 0.04);
  border-radius: 18rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  color: var(--ink);
}

.mini-ph {
  color: var(--muted);
  line-height: 70rpx;
}

.pick {
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  line-height: 1.4;
}

.pick-inner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  width: 100%;
}

.pin-ico {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  display: block;
}

.pick-text {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item {
  margin: 0 24rpx 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.thumb-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb {
  width: 100%;
  height: 100%;
}

.thumb-mark {
  width: 60rpx;
  height: 38rpx;
  opacity: 0.62;
}

.mid {
  flex: 1;
  min-width: 0;
}

.t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}

.m {
  font-size: 22rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 8rpx;
}

.orig {
  font-size: 22rpx;
  color: var(--muted);
  text-decoration: line-through;
}
