<view class="pcard" bindtap="onTap">
  <view class="cover">
    <image wx:if="{{item.coverUrl}}" class="cover-img" src="{{item.coverUrl}}" mode="aspectFill" />
    <text wx:else class="emoji">📦</text>
    <view class="st" wx:if="{{item.status && item.status !== 'ON_SALE' && item.statusLabel}}">{{item.statusLabel}}</view>
  </view>
  <view class="body">
    <view class="title">{{item.title}}</view>
    <view class="meta">
      <text wx:if="{{item.meetupName}}">{{item.meetupName}}</text>
      <text wx:if="{{item.meetupName && item.conditionLabel}}"> · </text>
      <text wx:if="{{item.conditionLabel}}">{{item.conditionLabel}}</text>
    </view>
    <view class="foot">
      <text class="price">¥{{item.priceText}}</text>
    </view>
  </view>
</view>
