.pcard {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(46, 65, 80, 0.06);
}
.cover {
  height: 220rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.emoji {
  font-size: 72rpx;
}
.st {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  background: #f7c9d4;
  color: #2e4150;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.body {
  padding: 16rpx 18rpx 20rpx;
}
.title {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meta {
  font-size: 20rpx;
  color: #7d8f9c;
  margin-top: 6rpx;
}
.foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}
.price {
  color: #4f90b8;
  font-weight: 700;
  font-size: 28rpx;
}
.fav {
  font-size: 20rpx;
  color: #8aa0b0;
}
