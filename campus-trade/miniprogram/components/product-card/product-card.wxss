.pcard {
  background: var(--card, #ffffff);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(46, 65, 80, 0.05);
}

.cover {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  background: var(--soft, #e8f4fa);
  overflow: hidden;
}

.cover-inner {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--soft, #e8f4fa);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-mark {
  width: 120rpx;
  height: 75rpx;
  opacity: 0.35;
}

.st {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
  box-shadow: 0 2rpx 8rpx rgba(46, 65, 80, 0.08);
}

.st-doing {
  background: var(--cream, #f6e7b4);
  color: var(--ink, #2e4150);
}

.st-done {
  background: var(--done, #d7efe0);
  color: var(--ink, #2e4150);
}

.st-muted {
  background: var(--line, #e4eef5);
  color: var(--muted, #7d8f9c);
}

.body {
  padding: 18rpx 20rpx 22rpx;
}

.title {
  height: 42rpx;
  line-height: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink, #2e4150);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row {
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.meetup {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted, #7d8f9c);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cond {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--pink, #f7c9d4);
  color: var(--ink, #2e4150);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
}

.foot {
  height: 42rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.price {
  color: var(--ink, #2e4150);
  font-weight: 800;
  font-size: 34rpx;
  line-height: 1.2;
}

.orig {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted, #7d8f9c);
  text-decoration: line-through;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
