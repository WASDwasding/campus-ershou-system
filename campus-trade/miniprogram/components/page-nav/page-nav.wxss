.nav {
  position: sticky;
  top: 0;
  z-index: 20;
  box-sizing: border-box;
  background: var(--bg, #f3f8fc);
}

.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-left {
  position: absolute;
  left: 8rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.nav-back {
  width: 68rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

.nav-back:active {
  opacity: 0.6;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--ink, #2e4150);
  border-bottom: 4rpx solid var(--ink, #2e4150);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink, #2e4150);
  line-height: 1.2;
}

.nav-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  font-size: 23rpx;
  font-weight: 500;
  color: var(--muted, #7d8f9c);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.nav-action:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.nav-right {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}

.nav-right:active {
  transform: translateY(-50%) scale(0.95);
  opacity: 0.9;
}

.nav-action-pill {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f2f8fc 100%);
  border: 1rpx solid rgba(206, 224, 238, 0.9);
  box-shadow: inset 0 2rpx 0 #ffffff, 0 4rpx 10rpx rgba(46, 65, 80, 0.06);
  color: var(--ink, #2e4150);
  font-weight: 600;
}

.nav-action-warn {
  background: linear-gradient(180deg, #fff6f8 0%, #fde5eb 100%);
  border-color: rgba(232, 150, 168, 0.68);
  color: #bc485b;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.95), 0 4rpx 12rpx rgba(196, 107, 107, 0.10);
}

.nav-action-ico {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  display: block;
}
