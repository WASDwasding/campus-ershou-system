page {
  --bg: #f3f8fc;
  --card: #ffffff;
  --ink: #2e4150;
  --muted: #7d8f9c;
  --action: #3e7ea3;
  --action-press: #336b8b;
  --soft: #e8f4fa;
  --blue-deco: #7eb6d9;
  --pink: #f7c9d4;
  --cream: #f6e7b4;
  --done: #d7efe0;
  --danger: #c46b6b;
  --line: #e4eef5;

  /* 兼容历史变量名引用，统一收敛到新色板 */
  --blue: var(--blue-deco);
  --blue-deep: var(--action);
  --field: var(--soft);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 65, 80, 0.05);
}

/* 按钮体系：Apple 轻三维柔光果冻/磨砂玻璃按钮（主按钮、冰蓝次按钮、珠光描边按钮、柔樱警示按钮、AI 星徽按钮） */
.btn {
  height: 92rpx;
  border-radius: 46rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  position: relative;
  transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.18s ease, opacity 0.16s ease;
}

.btn-ico {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  display: block;
}

.btn-ico-sm {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  display: block;
}

.btn-primary {
  background: linear-gradient(180deg, #569bc4 0%, #3e7ea3 56%, #346f92 100%);
  color: #ffffff;
  border: 1rpx solid rgba(45, 100, 133, 0.46);
  box-shadow:
    inset 0 2rpx 1rpx rgba(255, 255, 255, 0.44),
    inset 0 -3rpx 6rpx rgba(25, 60, 82, 0.22),
    0 10rpx 24rpx rgba(62, 126, 163, 0.26),
    0 2rpx 6rpx rgba(46, 65, 80, 0.08);
  text-shadow: 0 1rpx 2rpx rgba(25, 60, 82, 0.18);
}

.btn-primary .btn-ico {
  filter: drop-shadow(0 2rpx 5rpx rgba(22, 54, 74, 0.24));
}

.btn-primary:active {
  transform: scale(0.975) translateY(2rpx);
  background: linear-gradient(180deg, #4b8eb6 0%, #357093 100%);
  box-shadow:
    inset 0 2rpx 2rpx rgba(25, 60, 82, 0.18),
    0 4rpx 12rpx rgba(62, 126, 163, 0.20);
}

.btn-ghost {
  background: linear-gradient(180deg, #f4fafe 0%, #dfeffa 100%);
  color: #336d8e;
  border: 1rpx solid rgba(160, 204, 232, 0.75);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.96),
    0 6rpx 16rpx rgba(62, 126, 163, 0.10),
    0 1rpx 3rpx rgba(46, 65, 80, 0.04);
}

.btn-ghost .btn-ico {
  filter: drop-shadow(0 2rpx 5rpx rgba(62, 126, 163, 0.15));
}

.btn-ghost:active {
  transform: scale(0.975) translateY(1rpx);
  background: linear-gradient(180deg, #e8f4fc 0%, #d4e9f7 100%);
  box-shadow: inset 0 1rpx 2rpx rgba(62, 126, 163, 0.08), 0 3rpx 8rpx rgba(62, 126, 163, 0.08);
}

.btn-ai {
  gap: 12rpx;
  background: linear-gradient(135deg, #e8f5fe 0%, #f4effb 52%, #fdf5e2 100%);
  color: var(--ink);
  border: 1rpx solid rgba(136, 186, 220, 0.58);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.96),
    0 8rpx 20rpx rgba(62, 126, 163, 0.10),
    0 1rpx 4rpx rgba(46, 65, 80, 0.04);
}

.btn-ai-press,
.btn-ai:active {
  transform: scale(0.975) translateY(1rpx);
  opacity: 0.92;
}

.ai-ico {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 2rpx 6rpx rgba(74, 155, 232, 0.24));
}

.btn-outline {
  background: linear-gradient(180deg, #ffffff 0%, #f1faf5 100%);
  color: var(--ink);
  border: 1rpx solid rgba(132, 198, 170, 0.68);
  box-shadow:
    inset 0 2rpx 0 #ffffff,
    0 8rpx 20rpx rgba(46, 65, 80, 0.07),
    0 2rpx 5rpx rgba(56, 168, 118, 0.08);
}

.btn-outline .btn-ico {
  filter: drop-shadow(0 2rpx 5rpx rgba(46, 150, 102, 0.18));
}

.btn-outline:active {
  transform: scale(0.975) translateY(1rpx);
  background: linear-gradient(180deg, #f5fbf8 0%, #e5f5ed 100%);
}

.btn-warn {
  background: linear-gradient(180deg, #fff6f8 0%, #fde4ea 100%);
  color: #bc485b;
  border: 1rpx solid rgba(232, 148, 166, 0.72);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.96),
    0 6rpx 16rpx rgba(196, 107, 107, 0.12),
    0 1rpx 3rpx rgba(46, 65, 80, 0.04);
}

.btn-warn .btn-ico {
  filter: drop-shadow(0 2rpx 5rpx rgba(196, 90, 108, 0.18));
}

.btn-warn:active {
  transform: scale(0.975) translateY(1rpx);
  background: linear-gradient(180deg, #fdecef 0%, #f9d5de 100%);
}

.btn-disabled {
  background: linear-gradient(180deg, #eef4f8 0%, #e3edf4 100%);
  color: var(--muted);
  border: 1rpx solid rgba(210, 224, 236, 0.85);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

/* 筛选胶囊：轻三维柔光圆胶囊 */
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  vertical-align: middle;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: linear-gradient(180deg, #ffffff 0%, #f3f8fc 100%);
  color: var(--muted);
  border: 1rpx solid rgba(212, 228, 240, 0.9);
  box-shadow:
    inset 0 2rpx 0 #ffffff,
    0 4rpx 12rpx rgba(46, 65, 80, 0.05);
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.16s ease;
}

.chip:active {
  transform: scale(0.95);
}

.chip-ico {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  display: block;
  filter: drop-shadow(0 2rpx 4rpx rgba(46, 65, 80, 0.12));
}

.chip-on {
  background: linear-gradient(180deg, #569bc4 0%, #3e7ea3 100%);
  color: #ffffff;
  font-weight: 600;
  border-color: rgba(48, 106, 140, 0.5);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.40),
    0 6rpx 16rpx rgba(62, 126, 163, 0.24);
}

/* 状态与属性标签胶囊 */
.tag,
.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
}

.tag,
.pill-pink {
  background: var(--pink);
  color: var(--ink);
}

.tag-ai,
.pill-cream {
  background: var(--cream);
  color: var(--ink);
}

.pill-soft {
  background: var(--soft);
  color: var(--action);
}

.pill-done {
  background: var(--done);
  color: var(--ink);
}

.pill-muted {
  background: var(--line);
  color: var(--muted);
}

.tag-ref {
  background: var(--pink);
  color: var(--ink);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.muted {
  color: var(--muted);
}

.input-placeholder,
.textarea-placeholder {
  color: var(--muted);
}

/* 全站列表/卡片标准价格：34rpx 墨色 800；详情大价格用 .price-lg 44rpx */
.price {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.price-lg {
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.15;
}

.row {
  display: flex;
  align-items: center;
}

.space {
  justify-content: space-between;
}

/* 共用空状态：猫标 + 26rpx 次要色人话 + 可选次按钮 */
.empty {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--muted);
}

.empty-mark {
  width: 120rpx;
  height: 75rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}

.empty-illust {
  width: 212rpx;
  height: 212rpx;
  margin-bottom: 18rpx;
  filter: drop-shadow(0 12rpx 24rpx rgba(46, 65, 80, 0.08));
}

.empty-text {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--muted);
}

.btn.empty-btn {
  margin-top: 32rpx;
  height: 76rpx;
  padding: 0 48rpx;
  border-radius: 38rpx;
  font-size: 26rpx;
}

.load-fail {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--muted);
  font-size: 26rpx;
}

.load-fail-more {
  padding: 24rpx 40rpx;
}

.load-fail .retry {
  margin-top: 22rpx;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(180deg, #f4fafe 0%, #dfeffa 100%);
  border: 1rpx solid rgba(160, 204, 232, 0.75);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.96),
    0 6rpx 16rpx rgba(62, 126, 163, 0.10);
  color: #336d8e;
  font-size: 26rpx;
  font-weight: 600;
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
}

.load-fail .retry:active {
  transform: scale(0.96);
}

.retry-ico {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  display: block;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin: 0 0 16rpx;
}

.hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--action);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
