page {
  --green: #3d7a5a;
  --green-dark: #2c5a42;
  --green-soft: #e7f3ec;
  --pink: #e8a0bf;
  --cream: #fff8ee;
  --sky: #8ec8e3;
  --ink: #2a2a2a;
  --muted: #8a8a8a;
  --card: #ffffff;
  --warn: #e09a3a;
  --danger: #c45c5c;
  --line: #efe8dc;
  background: #f4f1ea;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(61, 122, 90, 0.06);
}

.btn {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  background: var(--green);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.86;
}

.btn-ghost {
  background: var(--green-soft);
  color: var(--green-dark);
}

.btn-warn {
  background: #fff4e4;
  color: #b36b12;
}

.btn-disabled {
  background: #d8d8d8;
  color: #fff;
}

.chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #f3eee6;
  color: #666;
}

.chip-on {
  background: var(--green);
  color: #fff;
}

.tag-ai {
  background: #eef6ff;
  color: #3a6ea5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.tag-ref {
  background: #fff4e4;
  color: #b36b12;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.muted {
  color: var(--muted);
}

.price {
  color: #c45c5c;
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
}

.space {
  justify-content: space-between;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--muted);
}

.empty-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 24rpx 0 16rpx;
}

.hint {
  font-size: 22rpx;
  color: var(--muted);
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #c45c5c;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
