page {
  --blue: #7eb6d9;
  --blue-deep: #4f90b8;
  --pink: #f7c9d4;
  --cream: #f6e7b4;
  --ink: #2e4150;
  --muted: #7d8f9c;
  --card: #ffffff;
  --line: #e4eef5;
  --field: #f3f8fc;
  --soft: #e8f4fa;
  background: #f3f8fc;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 65, 80, 0.06);
}

.btn {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  background: var(--blue);
  color: #fff;
}

.btn-primary:active {
  background: var(--blue-deep);
}

.btn-ghost {
  background: var(--soft);
  color: var(--blue-deep);
}

.btn-warn {
  background: var(--soft);
  color: var(--blue-deep);
}

.btn-disabled {
  background: #d5dee6;
  color: #fff;
}

.chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #fff;
  color: var(--ink);
}

.chip-on {
  background: var(--blue);
  color: #fff;
}

.tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--pink);
  color: var(--ink);
}

.tag-ai {
  background: var(--cream);
  color: var(--ink);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.tag-ref {
  background: var(--pink);
  color: var(--ink);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.muted {
  color: var(--muted);
}

.price {
  color: var(--blue-deep);
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
}

.space {
  justify-content: space-between;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--muted);
}

.empty-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 24rpx 0 16rpx;
}

.hint {
  font-size: 22rpx;
  color: var(--muted);
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--blue-deep);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
